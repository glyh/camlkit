# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis:
  "MCP server giving an agent OCaml toplevels, source queries and builds"
description: """
Gives an MCP client one or more live OCaml toplevels, merlin-backed
source queries and a dune build. A worker process owns the toplevel over
compiler-libs; the server supervises one worker per session and speaks MCP
over stdio."""
maintainer: ["Yihang Liu"]
authors: ["Yihang Liu"]
license: "MIT"
homepage: "https://github.com/glyh/camlkit"
bug-reports: "https://github.com/glyh/camlkit/issues"
depends: [
  "dune" {>= "3.20"}
  "ocaml" {>= "5.3.0"}
  "jsonrpc" {>= "1.20"}
  "merlin"
  "ocamlfind" {>= "1.9"}
  "yojson" {>= "2.0"}
  "alcotest" {>= "1.7" & with-test}
  "lwt" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/glyh/camlkit.git"
x-maintenance-intent: ["(latest)"]
